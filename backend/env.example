# Mente Fria — variáveis de ambiente do backend.
# Copie este arquivo para ".env" NA MESMA PASTA e preencha os valores.
# NUNCA comite o ".env" real (senhas e chaves). Só este ".env.example" vai para o Git.

# --- Obrigatórias hoje (lidas pelo application.properties) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mente_fria
DB_USER=postgres
# Mesma senha usada em POSTGRES_PASSWORD ao criar o container do banco.
DB_PASSWORD=

# --- Planejadas (ainda não lidas pelo código; entram com login, CORS e chamada ao Python) ---
# Chave que assina os tokens de login (JWT): texto longo e aleatório, diferente em cada ambiente.
JWT_SECRET=
CORS_ALLOWED_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
# Comando do Python na sua máquina: python, python3 ou py.
PYTHON_CMD=python
# Caminho relativo à pasta de onde o backend inicia (a pasta "backend").
OTIMIZADOR_SCRIPT=../optimization/app/otimizador.py
